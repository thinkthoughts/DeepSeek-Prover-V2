/-
RPI-DS-001a appendix, generated by tools/run_extract.sh. It is appended to a
byte-identical copy of the original Solution file so that proof terms are
inspected in the same elaboration that the kernel checked. The original
repository file stays unchanged.
-/
open Lean


def gdtModules : List Name := [`GeneralDivisorTheorem.Basic, `Solution.GeneralDivisorTheorem]

def moduleOf (env : Environment) (n : Name) : Option Name := do
  let idx ← env.getModuleIdxFor? n
  env.header.moduleNames[idx.toNat]?

def inGdt (env : Environment) (n : Name) : Bool :=
  (`GDT).isPrefixOf n &&
  (match moduleOf env n with
   | some m => gdtModules.contains m
   | none => true)  -- `none` = elaborated in this file (the verbatim Solution text)

def valueOf : ConstantInfo → Option Expr
  | .thmInfo t => some t.value
  | .defnInfo d => some d.value
  | .opaqueInfo o => some o.value
  | _ => none

def isAux (n : Name) : Bool := n.isInternalDetail || n.isInternal

/-- Constants of an expression, expanding same-module auxiliaries transitively. -/
partial def expand (env : Environment) (todo : List Name) (seen : NameSet) (acc : NameSet) : NameSet :=
  match todo with
  | [] => acc
  | n :: rest =>
    if seen.contains n then expand env rest seen acc else
    let seen := seen.insert n
    if inGdt env n && isAux n then
      match env.find? n with
      | some ci =>
        let cs := ci.type.getUsedConstants.toList ++ ((valueOf ci).map (·.getUsedConstants.toList)).getD []
        expand env (cs ++ rest) seen acc
      | none => expand env rest seen acc
    else expand env rest seen (acc.insert n)

def kindOf : ConstantInfo → String
  | .thmInfo _ => "theorem" | .defnInfo _ => "def" | .axiomInfo _ => "axiom"
  | .opaqueInfo _ => "opaque" | .inductInfo _ => "inductive" | .ctorInfo _ => "ctor"
  | .recInfo _ => "rec" | .quotInfo _ => "quot"

def extract : CoreM Unit := do
  let env ← getEnv
  let mut out : Array Json := #[]
  let mut names : Array Name := #[]
  for (n, _) in env.constants.toList do
    if inGdt env n && !isAux n then names := names.push n
  names := names.qsort (fun a b => a.toString < b.toString)
  for n in names do
    let some ci := env.find? n | continue
    let tdeps := expand env ci.type.getUsedConstants.toList {} {}
    let vconsts := ((valueOf ci).map (·.getUsedConstants.toList)).getD []
    let vdeps := expand env vconsts {} {}
    let gdtOnly (s : NameSet) := (s.toList.filter (fun m => inGdt env m && m != n)).map toString |>.toArray.qsort (· < ·)
    let nonGdt := (vdeps.toList.filter (fun m => !inGdt env m)).length
    let axs ← collectAxioms n
    out := out.push <| Json.mkObj [
      ("name", toJson n.toString), ("kind", toJson (kindOf ci)),
      ("module", toJson (((moduleOf env n).map toString).getD "Solution.GeneralDivisorTheorem")),
      ("has_value", toJson (valueOf ci).isSome),
      ("type_deps", toJson (gdtOnly tdeps)), ("value_deps", toJson (gdtOnly vdeps)),
      ("mathlib_value_consts", toJson nonGdt),
      ("axioms", toJson (axs.map toString |>.qsort (· < ·))),
      ("type_hash", toJson (toString ci.type.hash)),
      ("type_pp", toJson (toString (← (Meta.ppExpr ci.type).run' {} {})))]
  IO.println "@@RPI_JSON_BEGIN"
  IO.println (Json.arr out).pretty
  IO.println "@@RPI_JSON_END"

#eval extract
